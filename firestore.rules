rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responsaveis/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /idosoPasswordResetRequests/{cpf} {
      allow create, update: if cpf.matches('^[0-9]{11}$')
        && request.resource.data.keys().hasOnly(['cpf', 'requestedAt', 'requestedAtText'])
        && request.resource.data.keys().hasAll(['cpf', 'requestedAt', 'requestedAtText'])
        && request.resource.data.cpf == cpf
        && request.resource.data.requestedAtText is string;
      allow get: if request.auth != null;
      allow list: if false;
      allow delete: if request.auth != null;
    }

    match /idosos/{idosoId} {
      allow read: if request.auth != null && (
        request.auth.uid == idosoId || resource.data.responsavelId == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.responsavelId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.responsavelId == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == idosoId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'fotoPerfil',
          'updatedAt',
          'expoPushToken',
          'pushTokenUpdatedAt',
          'notificationsEnabled'
        ]);
      allow delete: if request.auth != null
        && resource.data.responsavelId == request.auth.uid;

      match /lembretes/{lembreteId} {
        allow read: if request.auth != null && (
          request.auth.uid == idosoId ||
          get(/databases/$(database)/documents/idosos/$(idosoId)).data.responsavelId == request.auth.uid
        );
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/idosos/$(idosoId)).data.responsavelId == request.auth.uid;
        allow update: if request.auth != null
          && request.auth.uid == idosoId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'confirmado',
            'confirmadoEm',
            'novo'
          ]);
      }

      match /medicacoes/{medicacaoId} {
        allow read: if request.auth != null && (
          request.auth.uid == idosoId ||
          get(/databases/$(database)/documents/idosos/$(idosoId)).data.responsavelId == request.auth.uid
        );
        allow create, delete: if request.auth != null
          && get(/databases/$(database)/documents/idosos/$(idosoId)).data.responsavelId == request.auth.uid;
        allow update: if request.auth != null && (
          request.auth.uid == idosoId ||
          get(/databases/$(database)/documents/idosos/$(idosoId)).data.responsavelId == request.auth.uid
        );
      }

      match /anotacoes/{anotacaoId} {
        allow read: if request.auth != null && (
          request.auth.uid == idosoId ||
          get(/databases/$(database)/documents/idosos/$(idosoId)).data.responsavelId == request.auth.uid
        );
        allow create: if request.auth != null
          && request.auth.uid == idosoId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'texto',
            'horario',
            'lembrarEm',
            'notificationId',
            'concluido',
            'concluidoEm',
            'createdBy',
            'createdAt',
            'createdAtText'
          ]);
        allow update: if request.auth != null
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'concluido',
            'concluidoEm',
            'notificationId'
          ]);
        allow update, delete: if request.auth != null && (
          request.auth.uid == resource.data.createdBy ||
          get(/databases/$(database)/documents/idosos/$(idosoId)).data.responsavelId == request.auth.uid
        );
      }
    }
  }
}
