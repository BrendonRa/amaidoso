# URL da API Express (MySQL) — enquanto a migração para Firebase não substituir estas rotas.
EXPO_PUBLIC_API_URL=http://192.168.0.10:5141

# Firebase: o app lê credenciais de google-services.json na raiz do frontend.
# Web: crie também um app Web no Firebase Console e copie o App ID.
# Sem isso, o SDK web usa o App ID Android do google-services.json, o que pode quebrar o Google popup.
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# Google OAuth: use o Client ID Web do mesmo projeto/provedor Google.
# Se o google-services.json já tiver oauth_client client_type 3, esta variável é opcional.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Nativo em development build: cadastre exatamente esta URI no fluxo OAuth que você usar.
# No Expo Go o Google OAuth não funciona de forma confiável; use web ou development build.
EXPO_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=amaidoso://oauth
