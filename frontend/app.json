{
  "expo": {
    "name": "Amaidoso",
    "slug": "amaidoso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/amaidoso-logo.png",
    "scheme": "amaidoso",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/amaidoso-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amaidoso.app"
    },
    "android": {
      "package": "com.amaidoso.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/amaidoso-logo.png"
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
